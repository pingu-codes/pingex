{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "CODEX_HOME=\"$HOME/.codex-personal\" deno task tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:work": "CODEX_HOME=\"$HOME/.codex-work\" deno task tauri dev --config src-tauri/tauri.dev.conf.json",
    "frontend:dev": "deno run -A npm:vite@8.1.5 --force",
    "build": "deno run -A npm:vite@8.1.5 build",
    "check": "deno run -A npm:svelte-check@4.7.3 --tsconfig ./tsconfig.json",
    "lint": "deno run -A npm:@biomejs/biome@2.5.4 check .",
    "lint:fix": "deno run -A npm:@biomejs/biome@2.5.4 check --write .",
    "format": "deno run -A npm:@biomejs/biome@2.5.4 format --write .",
    "test": "deno run -A npm:vitest@4.1.10 run",
    "test:watch": "deno run -A npm:vitest@4.1.10",
    "test:e2e:install": "deno run -A npm:playwright@1.61.1 install chromium webkit",
    "test:e2e": "deno run -A npm:playwright@1.61.1 test",
    "demo": "deno task demo:capture && deno task demo:index",
    "demo:capture": "deno run -A npm:playwright@1.61.1 test --config playwright.demo.config.ts",
    "demo:index": "deno run -A demo/index.ts",
    "rust:test": "cd src-tauri && cargo test",
    "test:e2e:codex": "cd src-tauri && PINGEX_LIVE_E2E=1 cargo test --test live_codex -- --test-threads=1",
    "rust:lint": "cd src-tauri && cargo clippy --all-targets",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "typegen": "cd src-tauri && cargo test --lib export_bindings",
    "versions:check": "deno run --allow-read --allow-run=git scripts/versions_check.ts",
    "tauri": "deno run -A npm:@tauri-apps/cli@2.11.4",
    "app:build": "deno task tauri build",
    "app:build:debug": "deno task tauri build --debug"
  },
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@2.5.4",
    "@playwright/test": "npm:@playwright/test@1.61.1",
    "@testing-library/jest-dom/": "npm:@testing-library/jest-dom@6.9.1/",
    "@testing-library/svelte": "npm:@testing-library/svelte@5.4.2",
    "@testing-library/svelte/": "npm:@testing-library/svelte@5.4.2/",
    "@testing-library/user-event": "npm:@testing-library/user-event@14.6.1",
    "@lucide/svelte": "npm:@lucide/svelte@1.25.0",
    "@skeletonlabs/skeleton": "npm:@skeletonlabs/skeleton@5.0.0",
    "@skeletonlabs/skeleton-svelte": "npm:@skeletonlabs/skeleton-svelte@5.0.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@7.2.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.3",
    "@tauri-apps/api/": "npm:@tauri-apps/api@2.11.1/",
    "@tauri-apps/cli": "npm:@tauri-apps/cli@2.11.4",
    "@tauri-apps/plugin-dialog": "npm:@tauri-apps/plugin-dialog@2.7.2",
    "@zag-js/interact-outside": "npm:@zag-js/interact-outside@1.42.0",
    "dompurify": "npm:dompurify@3.2.7",
    "highlight.js": "npm:highlight.js@11.11.1",
    "highlight.js/": "npm:/highlight.js@11.11.1/",
    "jsdom": "npm:jsdom@29.1.1",
    "marked": "npm:marked@16.4.1",
    "svelte": "npm:svelte@5.56.7",
    "svelte/": "npm:svelte@5.56.7/",
    "svelte-check": "npm:svelte-check@4.7.3",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "typescript": "npm:typescript@6.0.3",
    "vite": "npm:vite@8.1.5",
    "vitest": "npm:vitest@4.1.10",
    "vitest/": "npm:vitest@4.1.10/"
  }
}
