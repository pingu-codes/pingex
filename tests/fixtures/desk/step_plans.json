{
  "about": "Step plans the review desk makes, recorded once and held by both adapters: the Rust desk (review/desk/steps.rs, test `recorded_step_plans`) and the browser preview's fake (src/lib/services/preview/checkouts.test.ts). Each case opens `prs` from main, makes a worktree for each target in `ensure`, then plans `action` for `target`. A target's headRef and headSha are its PR's. headRepo is \"same\" (this repository), \"fork\" (someone's fork) or null (deleted). {home} is the Home's folder and {repo} the repository folder's name as a path segment.",
  "cases": [
    {
      "name": "reading someone else's PR needs no worktree",
      "prs": [{ "number": 13, "headRef": "feature" }],
      "target": { "number": 13, "mine": false, "headRepo": "same", "stack": null },
      "action": "read",
      "plan": {
        "stepUp": null,
        "confirm": null,
        "confirmPush": false,
        "refused": null,
        "switchBranch": false,
        "worktreePath": "{home}/pr-worktrees/{repo}/pr-13",
        "current": {
          "step": "noCheckout",
          "path": null,
          "gitBranch": null,
          "managed": false,
          "onPrBranch": false,
          "setupPending": null
        }
      }
    },
    {
