      "action": "runLocally",
      "plan": {
        "stepUp": "worktree",
        "confirm": "createWorktree",
        "confirmPush": false,
        "refused": null,
        "switchBranch": false,
        "worktreePath": "{home}/pr-worktrees/{repo}/pr-13",
