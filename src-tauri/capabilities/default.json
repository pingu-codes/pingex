{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main Pingex windows (extra account windows are labelled main-2, main-3, …)",
  "windows": ["main", "main-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    "deep-link:default"
  ]
}
