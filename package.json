{
  "name": "pingex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CODEX_HOME=\"$HOME/.codex-personal\" bun run tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:work": "CODEX_HOME=\"$HOME/.codex-work\" bun run tauri dev --config src-tauri/tauri.dev.conf.json",
    "frontend:dev": "bun --bun vite --force",
    "build": "bun --bun vite build",
    "check": "bun --bun svelte-check --tsconfig ./tsconfig.json && bun scripts/check-seams.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun --bun vitest run",
    "test:changed": "bun --bun vitest run --changed",
    "test:watch": "bun --bun vitest",
    "test:e2e:install": "bun --bun playwright install chromium webkit",
    "test:e2e": "bun --bun playwright test",
    "test:e2e:quick": "bun --bun playwright test --project=desktop-1180x760",
    "test:perf": "bun --bun playwright test diff-scroll --project=webkit --workers=1",
    "demo": "bun run demo:capture && bun run demo:index",
    "demo:capture": "bun --bun playwright test --config playwright.demo.config.ts",
    "demo:index": "bun demo/index.ts",
    "rust:test": "cd src-tauri && cargo test",
    "rust:test:lib": "cd src-tauri && cargo test --lib",
    "test:e2e:codex": "cd src-tauri && PINGEX_LIVE_E2E=1 RUST_TEST_THREADS=2 cargo test --test live_codex",
    "test:e2e:claude": "cd src-tauri && PINGEX_LIVE_E2E=1 cargo test --test live_claude",
    "test:e2e:maki": "cd src-tauri && PINGEX_LIVE_E2E=1 cargo test --test live_maki",
    "test:e2e:wsl": "cd src-tauri && cargo test --test live_wsl -- --test-threads=1 --nocapture",
    "rust:lint": "cd src-tauri && cargo clippy --all-targets",
    "rust:preflight": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -q && cargo test --lib -q",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "typegen": "cd src-tauri && cargo test --lib export_bindings",
    "versions:check": "bun scripts/versions_check.ts",
    "tauri": "tauri",
    "app:build": "bun run tauri build",
    "app:build:debug": "bun run tauri build --debug",
    "preflight": "bun run check && bun run lint && bun run test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@lucide/svelte": "1.66.0",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@zag-js/interact-outside": "1.47.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.3",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
