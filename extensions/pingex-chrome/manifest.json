{
  "manifest_version": 3,
  "name": "Pingex Browser Helper",
  "description": "Lets Pingex keep the tabs its agents use in a tab group, so you can see which tabs they own.",
  "version": "0.1.0",
  "minimum_chrome_version": "144",
  "key": "",
  "permissions": ["tabs", "tabGroups", "debugger", "alarms"],
  "background": { "service_worker": "service-worker.js" }
}
